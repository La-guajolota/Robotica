<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Definición de materiales -->
    
    <material name="green">
        <color rgba="0 0.6 0 1"/> <!-- Color verde -->
    </material>

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/> <!-- Color gris -->
    </material>
</robot>
