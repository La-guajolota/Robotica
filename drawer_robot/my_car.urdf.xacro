<?xml version="1.0"?>

<!-- 
    Archivo Xacro para definir un robot móvil simple llamado "my_car".
    Este robot tiene un cuerpo principal (base_link), dos ruedas delanteras (con articulaciones continuas)
    y una rueda trasera tipo caster (articulación fija). También incluye un enlace virtual para la base.
    Puede ser utilizado en simuladores como Gazebo o visualizado en RViz.
-->

<robot name="my_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Propiedades reutilizables -->
    <xacro:property name="base_length" value="0.6"/> <!-- Longitud de la base -->
    <xacro:property name="base_width" value="0.4"/> <!-- Ancho de la base -->
    <xacro:property name="base_height" value="0.2"/> <!-- Altura de la base -->
    <xacro:property name="wheel_radius" value="0.1"/> <!-- Radio de las ruedas -->
    <xacro:property name="wheel_length" value="0.05"/> <!-- Ancho de las ruedas -->
    <xacro:property name="caster_radius" value="0.05"/> <!-- Radio de la rueda trasera tipo caster -->

    <!-- Definición de materiales -->
    <material name="green">
        <color rgba="0 0.6 0 1"/> <!-- Color verde -->
    </material>
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/> <!-- Color gris -->
    </material>

    <!-- Macro para la definición de una rueda-->
    <xacro:macro name="wheel_link" params="prefix">
        <link name="wheel_front_${prefix}">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/> <!-- Cilindro con dimensiones definidas por propiedades -->
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/> <!-- Orientación para que sea perpendicular al suelo -->
                <material name="grey"/> <!-- Material gris -->
            </visual>
        </link>
    </xacro:macro>

    <!-- Definición del enlace base (base_link) -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/> <!-- Caja con dimensiones definidas por propiedades -->
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/> <!-- Posición del enlace en el marco de coordenadas -->
            <material name="green"/> <!-- Material verde -->
        </visual>
    </link>

    <!-- Definición de las ruedas delanteras -->
    <xacro:wheel_link prefix="left"/> <!-- Rueda delantera izquierda -->
    <xacro:wheel_link prefix="right"/> <!-- Rueda delantera derecha -->

    <!-- Definición de la rueda trasera tipo caster -->
    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}"/> <!-- Esfera con radio definido por propiedad -->
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/> <!-- Posición en el marco de coordenadas -->
            <material name="grey"/> <!-- Material gris -->
        </visual>
    </link>

    <!-- Enlace virtual para la base -->
    <link name="base_footprint"/>

    <!-- Definición de las articulaciones -->
    <!-- Articulación de la rueda delantera izquierda -->
    <joint name="wheel_front_left_joint" type="continuous">
        <parent link="base_link"/> <!-- Enlace padre -->
        <child link="wheel_front_left"/> <!-- Enlace hijo -->
        <origin xyz="-${base_length / 4.0} -${base_width / 2.0 - wheel_radius} 0" rpy="0 0 0"/> <!-- Posición de la articulación -->
        <axis xyz="0 1 0"/> <!-- Eje de rotación (Y) -->
    </joint>

    <!-- Articulación de la rueda delantera derecha -->
    <joint name="wheel_front_right_joint" type="continuous">
        <parent link="base_link"/> <!-- Enlace padre -->
        <child link="wheel_front_right"/> <!-- Enlace hijo -->
        <origin xyz="-${base_length / 4.0} ${base_width / 2.0 - wheel_radius} 0" rpy="0 0 0"/> <!-- Posición de la articulación -->
        <axis xyz="0 1 0"/> <!-- Eje de rotación (Y) -->
    </joint>

    <!-- Articulación fija de la rueda trasera tipo caster -->
    <joint name="caster_wheel_joint" type="fixed">
        <parent link="base_link"/> <!-- Enlace padre -->
        <child link="caster_wheel"/> <!-- Enlace hijo -->
        <origin xyz="${base_length / 3.0} 0 -${caster_radius}" rpy="0 0 0"/> <!-- Posición de la articulación -->
    </joint>

    <!-- Articulación fija entre base_footprint y base_link -->
    <joint name="virtual_base_link_joint" type="fixed">
        <parent link="base_footprint"/> <!-- Enlace padre -->
        <child link="base_link"/> <!-- Enlace hijo -->
        <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/> <!-- Posición de la articulación -->
    </joint>

</robot>